# Local development needs none of this — everything below has a working default
# except ADMIN_PASSWORD, and /admin stays locked until that is set.

# Set by Railway automatically once a Postgres service is attached.
# Leave unset locally to use a SQLite file in the project root.
# DATABASE_URL=postgresql://...

ADMIN_USER=alex
ADMIN_PASSWORD=

# Appears in meta tags. The domain drawn on the strip itself lives in
# static/js/tokens.js, because the renderer runs in the browser.
SITE_DOMAIN=weekform.app

SHARE_RATE_LIMIT=30
